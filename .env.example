# --- Database (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional but recommended: the project's secret key (server-only, never NEXT_PUBLIC_). When set it is used instead of
# the publishable key, and you can delete the "app_all" policies from supabase/schema.sql.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign the login cookie. Set any long random string.
AUTH_SECRET=

# --- Upload forms (OCR) ---
# Google AI Studio key for reading photographed forms (https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.6-flash). See https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# Optional password for /collect (sent as the x-access-key header; the page asks for it once).
UPLOAD_ACCESS_KEY=

# --- One-time import of the old Google Sheet (only used by `npm run db:seed`) ---
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
RESPONSES_SHEET_ID=
