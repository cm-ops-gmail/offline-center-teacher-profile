# Google Sheet to read (the ID from the sheet URL)
GOOGLE_SHEET_ID=
# Service account — share the sheet with this email as Viewer
GOOGLE_CLIENT_EMAIL=
# Paste the private key on ONE line, keeping the literal \n between lines, inside double quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Upload forms (OCR) ---
# Google AI Studio key for reading photographed forms (https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.6-flash). See https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash

# The spreadsheet where each student's answers are saved first (share it with the service account as Editor)
RESPONSES_SHEET_ID=
# Required to use /collect in production (sent as the x-access-key header; the page asks for it once).
# Leave empty for local development only — uploads are refused in production without it.
UPLOAD_ACCESS_KEY=
